#!/usr/bin/env ruby
# frozen_string_literal: true

# ============================================================
# חיבור דף פייסבוק לתיבת תגובות ב-Chatwoot
#
# עושה שלושה דברים:
#   1. מוסיף את ה-field `feed` ל-subscribed_apps של הדף  <- העקיפה של
#      channel/facebook_page.rb:53, בלי לגעת בקובץ
#   2. יוצר תיבת API בשם "תגובות — <שם הדף>"
#   3. מפנה את ה-webhook היוצא שלה ל-/social-comments/outgoing
#
# הרצה:
#   rails runner /app/bin/social-comments-connect <account_id> <page_id>
#
# הטוקן נקרא מ-stdin — לא מ-argv, כדי שלא יופיע ב-ps או בהיסטוריה.
# אפשר להזין System User token: הסקריפט יגזור ממנו Page Token לבד.
# ============================================================

require 'net/http'
require 'json'

GRAPH = 'https://graph.facebook.com/v23.0'

def die(msg)
  warn "\n🔴 #{msg}"
  exit 1
end

# הטוקן תמיד ב-Authorization header ולא ב-query string —
# query strings נרשמים בלוגים של שרתים ופרוקסי.
def graph(path, token, form = nil)
  uri = URI("#{GRAPH}/#{path}")
  req = form ? Net::HTTP::Post.new(uri) : Net::HTTP::Get.new(uri)
  req['Authorization'] = "Bearer #{token}"
  req.set_form_data(form) if form
  res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |http| http.request(req) }
  JSON.parse(res.body)
rescue StandardError => e
  { 'error' => { 'message' => e.message } }
end

account_id, page_id = ARGV[0], ARGV[1]
die('שימוש: rails runner social-comments-connect <account_id> <page_id>') if account_id.nil? || page_id.nil?

token = $stdin.read.to_s.strip
die('לא התקבל טוקן ב-stdin') if token.empty?

account = Account.find_by(id: account_id) or die("לא נמצא חשבון #{account_id}")

# --- 1. גזירת Page Token ---
# System User token לא מורשה ל-subscribed_apps, אבל כן יכול לגזור Page Token.
# אם כבר קיבלנו Page Token, הגזירה פשוט מחזירה אותו עצמו.
probe = graph("#{page_id}?fields=name,access_token", token)
die("הטוקן או מזהה הדף שגויים: #{probe.dig('error', 'message')}") if probe['name'].nil?

page_name  = probe['name']
page_token = probe['access_token'] || token
derived    = probe['access_token'] ? ' (נגזר אוטומטית)' : ''

puts "\n✅ הדף זוהה: #{page_name}"
puts "   Page Token#{derived}"

# --- 2. הרשמה ל-feed (העקיפה המרכזית) ---
# משמרים את מה ש-Chatwoot כבר רשם ומוסיפים feed מעליו.
current  = graph("#{page_id}/subscribed_apps", page_token)
existing = Array(current['data']).flat_map { |a| Array(a['subscribed_fields']) }.uniq
fields   = (existing + %w[feed]).uniq

sub = graph("#{page_id}/subscribed_apps", page_token, 'subscribed_fields' => fields.join(','))
die("הרשמת ה-webhook נכשלה: #{sub.dig('error', 'message')}") unless sub['success']

puts "✅ נרשם ל-webhook. שדות: #{fields.join(', ')}"
puts '   (feed הוא זה שמעביר תגובות — בלעדיו שום תגובה לא מגיעה)' unless existing.include?('feed')

# --- 3. תיבת API ---
inbox_name = "תגובות — #{page_name}"
inbox = account.inboxes.find_by(name: inbox_name)

if inbox
  channel = inbox.channel
  puts "\n↻ התיבה כבר קיימת (id #{inbox.id}) — מעדכן"
else
  channel = Channel::Api.create!(account: account, webhook_url: '')
  inbox = account.inboxes.create!(name: inbox_name, channel: channel)
  puts "\n✅ נוצרה תיבה: #{inbox_name} (id #{inbox.id})"
end

attrs = channel.additional_attributes || {}
attrs['fb_page_id']    = page_id
attrs['fb_page_token'] = page_token
attrs['fb_page_name']  = page_name
channel.update!(
  additional_attributes: attrs,
  webhook_url: "#{ENV.fetch('FRONTEND_URL', '')}/social-comments/outgoing"
)

puts "✅ ה-webhook היוצא מכוון ל-#{channel.webhook_url}"

puts <<~DONE

  ─────────────────────────────────────────
  מוכן. הדף «#{page_name}» מחובר לתיבה «#{inbox_name}».

  לבדיקה חיה:
    1. כתוב תגובה על פוסט כלשהו בדף
    2. השיחה אמורה להיפתח בתיבה תוך שניות
    3. ענה מ-Chatwoot — התשובה תתפרסם כתגובה פומבית

  אם לא הופיע כלום:
    docker logs chatwoot-rails-1 --since 10m 2>&1 | grep social-comments
  ─────────────────────────────────────────

DONE
